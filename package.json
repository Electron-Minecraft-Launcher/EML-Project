		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.2.0",
		"canvas-confetti": "^1.9.4",
		"fast-xml-parser": "^5.11.0",
		"globals": "^17.11.0",
		"highlight.js": "^11.12.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-github-blockquote-alert": "^2.1.0",
		"sass": "^1.103.0",
		"svelte": "^5.56.10",
